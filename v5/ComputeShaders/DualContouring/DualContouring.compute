// ============================================================
// LOD BOUNDARY MERGE
// ============================================================

void DecodeMergeCellIndex(
    uint index,
    out int x,
    out int y,
    out int z)
{
    uint rowSize =
        (uint) CellCount *
        (uint) CellCount;

    z =
        (int) (
            index /
            rowSize
        );

    uint remainder =
        index %
        rowSize;

    y =
        (int) (
            remainder /
            (uint) CellCount
        );

    x =
        (int) (
            remainder %
            (uint) CellCount
        );
}


float3 GetCellCenterFromIndex(
    uint index)
{
    int x;
    int y;
    int z;

    DecodeMergeCellIndex(
        index,
        x,
        y,
        z
    );

    return
        Origin +
        (
            float3(
                x,
                y,
                z
            )
            +
            float3(
                0.5f,
                0.5f,
                0.5f
            )
        )
        *
        Step;
}


float3 GetCellMinFromIndex(
    uint index)
{
    int x;
    int y;
    int z;

    DecodeMergeCellIndex(
        index,
        x,
        y,
        z
    );

    return
        Origin +
        float3(
            x,
            y,
            z
        )
        *
        Step;
}


float3 GetCellMaxFromIndex(
    uint index)
{
    return
        GetCellMinFromIndex(
            index
        )
        +
        float3(
            Step,
            Step,
            Step
        );
}


void AddTranslatedQef(
    QefData source,
    float3 sourceCenter,
    float3 mergedCenter,

    inout float a00,
    inout float a01,
    inout float a02,

    inout float a11,
    inout float a12,

    inout float a22,

    inout float b0,
    inout float b1,
    inout float b2,

    inout float3 intersectionSum,

    inout uint intersectionCount,

    inout uint constraintCount)
{
    float3 delta =
        mergedCenter -
        sourceCenter;

    a00 += source.A00;
    a01 += source.A01;
    a02 += source.A02;

    a11 += source.A11;
    a12 += source.A12;

    a22 += source.A22;

    float shiftedB0 =
        source.B0
        -
        (
            source.A00 * delta.x
            +
            source.A01 * delta.y
            +
            source.A02 * delta.z
        );

    float shiftedB1 =
        source.B1
        -
        (
            source.A01 * delta.x
            +
            source.A11 * delta.y
            +
            source.A12 * delta.z
        );

    float shiftedB2 =
        source.B2
        -
        (
            source.A02 * delta.x
            +
            source.A12 * delta.y
            +
            source.A22 * delta.z
        );

    b0 += shiftedB0;
    b1 += shiftedB1;
    b2 += shiftedB2;

    intersectionSum +=
        source.IntersectionSum;

    intersectionCount +=
        source.IntersectionCount;

    constraintCount +=
        source.ConstraintCount;
}


// ============================================================
// MERGE GROUP
// ============================================================

[numthreads(64, 1, 1)]
void CSMergeBoundaryVertices(
    uint3 id : SV_DispatchThreadID)
{
    uint groupIndex =
        id.x;

    uint groupCount =
        MergeGroupCountBuffer[
            CounterSlot
        ];

    if (groupIndex >= groupCount)
    {
        return;
    }

    MergeGroup mergeGroup =
        MergeGroupBuffer[
            groupIndex
        ];

    uint member0 =
        mergeGroup.Member0;

    uint member1 =
        mergeGroup.Member1;

    uint member2 =
        mergeGroup.Member2;

    uint member3 =
        mergeGroup.Member3;

    bool valid0 =
        VertexValid[
            member0
        ] != 0u;

    bool valid1 =
        VertexValid[
            member1
        ] != 0u;

    bool valid2 =
        VertexValid[
            member2
        ] != 0u;

    bool valid3 =
        VertexValid[
            member3
        ] != 0u;

    if (!valid0 &&
        !valid1 &&
        !valid2 &&
        !valid3)
    {
        return;
    }


    // ========================================================
    // MERGED BOUNDS
    // ========================================================

    float3 mergedMin =
        float3(
            1e30f,
            1e30f,
            1e30f
        );

    float3 mergedMax =
        float3(
            -1e30f,
            -1e30f,
            -1e30f
        );


    if (valid0)
    {
        mergedMin =
            min(
                mergedMin,
                GetCellMinFromIndex(
                    member0
                )
            );

        mergedMax =
            max(
                mergedMax,
                GetCellMaxFromIndex(
                    member0
                )
            );
    }


    if (valid1)
    {
        mergedMin =
            min(
                mergedMin,
                GetCellMinFromIndex(
                    member1
                )
            );

        mergedMax =
            max(
                mergedMax,
                GetCellMaxFromIndex(
                    member1
                )
            );
    }


    if (valid2)
    {
        mergedMin =
            min(
                mergedMin,
                GetCellMinFromIndex(
                    member2
                )
            );

        mergedMax =
            max(
                mergedMax,
                GetCellMaxFromIndex(
                    member2
                )
            );
    }


    if (valid3)
    {
        mergedMin =
            min(
                mergedMin,
                GetCellMinFromIndex(
                    member3
                )
            );

        mergedMax =
            max(
                mergedMax,
                GetCellMaxFromIndex(
                    member3
                )
            );
    }


    float3 mergedCenter =
        (
            mergedMin +
            mergedMax
        )
        *
        0.5f;


    // ========================================================
    // MERGED QEF
    // ========================================================

    float a00 = 0.0f;
    float a01 = 0.0f;
    float a02 = 0.0f;

    float a11 = 0.0f;
    float a12 = 0.0f;

    float a22 = 0.0f;

    float b0 = 0.0f;
    float b1 = 0.0f;
    float b2 = 0.0f;

    float3 intersectionSum =
        float3(
            0.0f,
            0.0f,
            0.0f
        );

    uint intersectionCount =
        0u;

    uint constraintCount =
        0u;


    if (valid0)
    {
        AddTranslatedQef(
            QefDataBuffer[
                member0
            ],

            GetCellCenterFromIndex(
                member0
            ),

            mergedCenter,

            a00,
            a01,
            a02,

            a11,
            a12,

            a22,

            b0,
            b1,
            b2,

            intersectionSum,

            intersectionCount,

            constraintCount
        );
    }


    if (valid1)
    {
        AddTranslatedQef(
            QefDataBuffer[
                member1
            ],

            GetCellCenterFromIndex(
                member1
            ),

            mergedCenter,

            a00,
            a01,
            a02,

            a11,
            a12,

            a22,

            b0,
            b1,
            b2,

            intersectionSum,

            intersectionCount,

            constraintCount
        );
    }


    if (valid2)
    {
        AddTranslatedQef(
            QefDataBuffer[
                member2
            ],

            GetCellCenterFromIndex(
                member2
            ),

            mergedCenter,

            a00,
            a01,
            a02,

            a11,
            a12,

            a22,

            b0,
            b1,
            b2,

            intersectionSum,

            intersectionCount,

            constraintCount
        );
    }


    if (valid3)
    {
        AddTranslatedQef(
            QefDataBuffer[
                member3
            ],

            GetCellCenterFromIndex(
                member3
            ),

            mergedCenter,

            a00,
            a01,
            a02,

            a11,
            a12,

            a22,

            b0,
            b1,
            b2,

            intersectionSum,

            intersectionCount,

            constraintCount
        );
    }


    if (intersectionCount == 0u)
    {
        return;
    }


    // ========================================================
    // SOLVE
    // ========================================================

    float3 localSolution =
        float3(
            0.0f,
            0.0f,
            0.0f
        );

    bool solved =
        false;


    if (constraintCount > 0u)
    {
        solved =
            SolveQEF(
                a00,
                a01,
                a02,

                a11,
                a12,

                a22,

                b0,
                b1,
                b2,

                localSolution
            );
    }


    float3 mergedVertex;


    if (solved)
    {
        mergedVertex =
            mergedCenter +
            localSolution;
    }
    else
    {
        mergedVertex =
            intersectionSum /
            (float) intersectionCount;
    }


    // ========================================================
    // KEEP VERTEX INSIDE MERGED REGION
    // ========================================================

    bool outside =
        mergedVertex.x < mergedMin.x ||
        mergedVertex.x > mergedMax.x ||
        mergedVertex.y < mergedMin.y ||
        mergedVertex.y > mergedMax.y ||
        mergedVertex.z < mergedMin.z ||
        mergedVertex.z > mergedMax.z;


    if (outside)
    {
        mergedVertex =
            intersectionSum /
            (float) intersectionCount;
    }


    // ========================================================
    // REPLACEMENT VERTEX
    // ========================================================

    uint replacementLocalIndex =
        member0;


    if (!valid0)
    {
        if (valid1)
        {
            replacementLocalIndex =
                member1;
        }
        else if (valid2)
        {
            replacementLocalIndex =
                member2;
        }
        else
        {
            replacementLocalIndex =
                member3;
        }
    }


    uint replacementCompactIndex =
        VertexIndexBuffer[
            replacementLocalIndex
        ];


    VertexBuffer[
        replacementCompactIndex
    ] =
        mergedVertex;


    float3 mergedNormal =
        EstimateNormal(
            mergedVertex
        );


    if (dot(
            mergedNormal,
            mergedNormal
        ) < EPSILON)
    {
        mergedNormal =
            float3(
                0.0f,
                1.0f,
                0.0f
            );
    }
    else
    {
        mergedNormal =
            normalize(
                mergedNormal
            );
    }


    NormalBuffer[
        replacementCompactIndex
    ] =
        mergedNormal;


    // ========================================================
    // ALIAS
    // ========================================================

    if (valid0)
    {
        VertexIndexBuffer[
            member0
        ] =
            replacementCompactIndex;
    }

    if (valid1)
    {
        VertexIndexBuffer[
            member1
        ] =
            replacementCompactIndex;
    }

    if (valid2)
    {
        VertexIndexBuffer[
            member2
        ] =
            replacementCompactIndex;
    }

    if (valid3)
    {
        VertexIndexBuffer[
            member3
        ] =
            replacementCompactIndex;
    }
}


